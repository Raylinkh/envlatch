    "error.group.conflictingSecretEnvironment" : {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"密钥组将 %@ 和 %@ 同时映射到 %@。请为每个所选密钥设置不同的目标环境变量名称。"}}}},
